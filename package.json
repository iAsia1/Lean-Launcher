{
  "name": "lean-launcher",
  "version": "1.0.2",
  "description": "Lean Launcher first release",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "electron": "electron .",
    "build": "electron-builder"
  },
  "keywords": [],
  "author": "Lyam",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.8.3",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.leanlauncher.launcher",
    "productName": "Lean Launcher",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "Lyam999gh",
      "repo": "Lean-Launcher"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage",
        "dir"
      ],
      "icon": "icon.png",
      "category": "Game"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.icns"
    },
    "files": [
      "**/*",
      "!minecraft/assets/objects",
      "!minecraft/libraries",
      "!minecraft/natives",
      "!minecraft/logs",
      "!minecraft/cache",
      "!minecraft/saves",
      "!minecraft/instances",
      "!minecraft/forge",
      "!minecraft/config",
      "!minecraft/mods",
      "!minecraft/resourcepacks"
    ]
  }
}
